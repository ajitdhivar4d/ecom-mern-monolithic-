{
  "name": "shopnest-full-stack",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "install-all": "npm install && npm --prefix backend install && npm --prefix frontend install --include=dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "concurrently": "^10.0.7"
  }
}
